diff --git a/tests/test_fedora.py b/tests/test_fedora.py
new file mode 100644
index 0000000..b3000fd
--- /dev/null
+++ b/tests/test_fedora.py
@@ -0,0 +1,173 @@
+"""Running outside Arch: firewalld instead of UFW, dnf instead of pacman, no
+vercmp, and notify-send instead of Omarchy's notifier. Every command the CLI
+would reach for is a stub in a private bin directory, so the answers do not
+depend on the machine the tests run on."""
+import os
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+OMDROP = ROOT / "bin" / "omdrop"
+
+RULE = ('rule family="ipv6" source address="fe80::/10" destination address="fe80::/10" '
+        'port port="8771" protocol="tcp" accept')
+
+
+class Stubbed(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.bin = Path(self.tmp.name) / "bin"
+        self.bin.mkdir()
+        self.capture = Path(self.tmp.name) / "capture"
+        self.env = os.environ.copy()
+        self.env.update(
+            PATH=f"{self.bin}:{self.env['PATH']}",
+            CAPTURE=str(self.capture),
+            HOME=self.tmp.name,
+            XDG_CONFIG_HOME=str(Path(self.tmp.name) / "config"),
+        )
+
+    def command(self, name, body):
+        path = self.bin / name
+        path.write_text(body)
+        path.chmod(0o755)
+
+    def run_omdrop(self, *args):
+        return subprocess.run([OMDROP, *args], env=self.env, capture_output=True, text=True)
+
+
+class FirewalldTests(Stubbed):
+    def setUp(self):
+        super().setUp()
+        # Only firewalld is active, whatever else the machine has installed.
+        self.command("systemctl", """#!/bin/sh
+[ "$1" = is-active ] || exit 0
+case "$*" in *firewalld.service*) exit 0 ;; esac
+exit 3
+""")
+        self.command("sudo", """#!/bin/sh
+for arg do printf '<%s>' "$arg" >> "$CAPTURE"; done
+echo >> "$CAPTURE"
+""")
+        self.command("firewall-cmd", """#!/bin/sh
+case "$*" in
+  *--get-zone-of-interface*) exit 2 ;;
+  *--get-default-zone*) echo public ;;
+  *--query-rich-rule*) exit "${RICH_RC:-1}" ;;
+  *--list-ports*) echo "${PORTS:-}" ;;
+esac
+""")
+
+    def test_install_adds_one_link_local_rule_to_the_zone_awdl0_falls_in(self):
+        result = self.run_omdrop("firewall", "install")
+
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(self.capture.read_text().splitlines(), [
+            f"<firewall-cmd><--permanent><--zone=public><--add-rich-rule={RULE}>",
+            f"<firewall-cmd><--zone=public><--add-rich-rule={RULE}>",
+        ])
+
+    def test_install_changes_nothing_when_the_zone_already_lets_the_port_in(self):
+        # Fedora Workstation's default zone.
+        self.env["PORTS"] = "1025-65535/udp 1025-65535/tcp"
+
+        result = self.run_omdrop("firewall", "install")
+
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertFalse(self.capture.exists())
+        self.assertIn("already", result.stdout)
+
+    def test_a_udp_range_or_another_port_does_not_count_as_open(self):
+        self.env["PORTS"] = "1025-65535/udp 8770/tcp 9000-9100/tcp"
+
+        result = self.run_omdrop("firewall", "install")
+
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(len(self.capture.read_text().splitlines()), 2)
+
+    def test_remove_takes_out_only_the_rule_it_added(self):
+        self.env["RICH_RC"] = "0"
+
+        result = self.run_omdrop("firewall", "remove")
+
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(self.capture.read_text().splitlines(), [
+            f"<firewall-cmd><--permanent><--zone=public><--remove-rich-rule={RULE}>",
+            f"<firewall-cmd><--zone=public><--remove-rich-rule={RULE}>",
+        ])
+
+    def test_remove_without_a_rule_asks_for_no_privilege(self):
+        result = self.run_omdrop("firewall", "remove")
+
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertFalse(self.capture.exists())
+
+
+class WithoutPacmanTests(Stubbed):
+    """A probing backend with a contract, on a machine that has dnf and no
+    pacman or vercmp."""
+
+    def setUp(self):
+        super().setUp()
+        # A PATH of stubs and the base system only: no pacman, no vercmp, even
+        # on a machine that has them.
+        for tool in ("bash", "sh", "cat", "sort", "head", "grep", "sed", "readlink", "dirname",
+                     "basename", "id", "mkdir", "env", "tr", "awk", "hostname", "timeout",
+                     "sleep", "rm", "mktemp", "flock", "date", "tail", "printf", "ln"):
+            for d in ("/usr/bin", "/bin"):
+                if Path(d, tool).exists():
+                    (self.bin / tool).symlink_to(Path(d, tool))
+                    break
+        self.env["PATH"] = str(self.bin)
+        self.command("dnf", "#!/bin/sh\nexit 0\n")
+        self.command("systemctl", "#!/bin/sh\nexit 3\n")
+        # The receiver's libraries are missing; everything else python3 does
+        # for the CLI (JSON in and out) goes to the real one.
+        real = subprocess.run(["sh", "-c", "command -v python3"], capture_output=True,
+                              text=True).stdout.strip()
+        self.command("python3", f"""#!/bin/sh
+case "$2" in *libarchive*|*libkeyutils*) exit 1 ;; esac
+exec {real} "$@"
+""")
+        self.backend = Path(self.tmp.name) / "omdrop-discoverable"
+        self.env["OMDROP_DISCOVERABLE"] = str(self.backend)
+
+    def probe(self, contract):
+        self.backend.write_text(f"""#!/bin/sh
+[ "$1" = probe ] && echo '{{"backend": "owl", "version": "0.1.0", "contract": "{contract}", "hardware": true, "missing": []}}'
+exit 0
+""")
+        self.backend.chmod(0o755)
+
+    def test_a_newer_contract_is_accepted_without_vercmp(self):
+        self.probe("0.10.0")       # sorts below 0.7.0 as text, above it as a version
+
+        result = self.run_omdrop("doctor", "--json")
+
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertNotIn("vercmp", result.stderr)
+        self.assertNotIn('"id": "backend"', result.stdout)
+
+    def test_an_older_contract_is_still_refused(self):
+        self.probe("0.6.9")
+
+        result = self.run_omdrop("doctor", "--json")
+
+        self.assertIn('"id": "backend"', result.stdout)
+
+    def test_the_receiver_packages_are_named_for_dnf(self):
+        self.probe("0.8.1")
+
+        result = self.run_omdrop("install-driver")
+
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertIn("sudo dnf install python3-libarchive-c keyutils-libs", result.stdout)
+        self.assertNotIn("pacman", result.stdout)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_senders.py b/tests/test_senders.py
new file mode 100644
index 0000000..42a52ad
--- /dev/null
+++ b/tests/test_senders.py
@@ -0,0 +1,36 @@
+"""The known-senders list, as the panel edits it."""
+import os
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+OMDROP = Path(__file__).resolve().parents[1] / "bin" / "omdrop"
+
+
+class SendersTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.env = {**os.environ, "HOME": self.tmp.name, "XDG_CONFIG_HOME": self.tmp.name}
+
+    def omdrop(self, *args):
+        return subprocess.run([OMDROP, "senders", *args], env=self.env, capture_output=True, text=True)
+
+    def test_the_last_sender_can_be_removed(self):
+        self.omdrop("add", "a@example.com")
+        result = self.omdrop("remove", "a@example.com")
+
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertIn("0 known", result.stdout)
+        self.assertEqual(self.omdrop("list", "--json").stdout.strip(), "[]")
+
+    def test_removing_one_of_two_keeps_the_other(self):
+        self.omdrop("add", "a@example.com", "+4366012345")
+        self.omdrop("remove", "a@example.com")
+
+        self.assertEqual(self.omdrop("list", "--json").stdout.strip(), '["+4366012345"]')
+
+
+if __name__ == "__main__":
+    unittest.main()
