 cmd_firewall() {
   local action=${1:-}
+  if [[ "$action" == install || "$action" == remove ]] && ! ufw_active && firewalld_active; then
+    cmd_firewall_firewalld "$action"
+    return
+  fi
   case "$action" in
     install)
       if ! command -v ufw >/dev/null 2>&1; then
