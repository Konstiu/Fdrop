+# firewalld (Fedora) has no rule that names an interface, so the same exception
+# goes into the zone awdl0 falls in, as a rich rule: IPv6 link-local to
+# link-local, TCP 8771. Nothing is added when that zone already lets the port
+# in, as Fedora Workstation's does (1025-65535).
+FIREWALLD_RULE='rule family="ipv6" source address="fe80::/10" destination address="fe80::/10" port port="8771" protocol="tcp" accept'
+
+firewalld_active() {
+  command -v firewall-cmd >/dev/null 2>&1 \
+    && systemctl is-active --quiet firewalld.service
+}
+
+firewalld_zone() {
+  firewall-cmd --get-zone-of-interface=awdl0 2>/dev/null || firewall-cmd --get-default-zone
+}
+
+firewalld_open() {  # ZONE
+  local p lo hi
+  firewall-cmd --zone="$1" --query-rich-rule="$FIREWALLD_RULE" >/dev/null 2>&1 && return 0
+  for p in $(firewall-cmd --zone="$1" --list-ports 2>/dev/null); do
+    [[ "$p" == */tcp ]] || continue
+    p=${p%/tcp}; lo=${p%-*}; hi=${p#*-}
+    [[ "$lo" =~ ^[0-9]+$ && "$hi" =~ ^[0-9]+$ ]] || continue
+    (( lo <= 8771 && 8771 <= hi )) && return 0
+  done
+  return 1
+}
+
+# Whether `firewall install` has anything to do here.
+firewall_rule_wanted() {
+  ufw_active && return 0
+  firewalld_active && ! firewalld_open "$(firewalld_zone)"
+}
+
+cmd_firewall_firewalld() {
+  local action=$1 zone; zone=$(firewalld_zone) || die "omdrop could not ask firewalld for its zones."
+  case "$action" in
+    install)
+      if firewalld_open "$zone"; then
+        echo "firewalld's $zone zone already lets the AirDrop receiver's port in; Omdrop did not change its configuration."
+        return 0
+      fi
+      echo "Allowing AirDrop receiver traffic in firewalld's $zone zone: only from IPv6 link-local peers, to TCP 8771."
+      sudo firewall-cmd --permanent --zone="$zone" --add-rich-rule="$FIREWALLD_RULE" \
+        && sudo firewall-cmd --zone="$zone" --add-rich-rule="$FIREWALLD_RULE"
+      ;;
+    remove)
+      if ! firewall-cmd --zone="$zone" --query-rich-rule="$FIREWALLD_RULE" >/dev/null 2>&1; then
+        echo "There is no Omdrop rule in firewalld's $zone zone to remove."
+        return 0
+      fi
+      sudo firewall-cmd --permanent --zone="$zone" --remove-rich-rule="$FIREWALLD_RULE"
+      sudo firewall-cmd --zone="$zone" --remove-rich-rule="$FIREWALLD_RULE"
+      ;;
+  esac
+}
